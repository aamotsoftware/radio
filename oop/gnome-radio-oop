  </interface>
</node>
"""


class MPRISService:
    """Eksponerer RadioPlayer over MPRIS2 (org.mpris.MediaPlayer2) på
    D-Bus-sesjonsbussen.

    Dette gjør at GNOME Shell sitt medieelement viser stasjonen som
    spilles, og at medietaster på tastaturet (play/pause/stop) fungerer
    – uten at RadioPlayer eller RadioWindow trenger å kjenne til D-Bus.
    """

    BUS_NAME = "org.mpris.MediaPlayer2.gnomeradio"
    OBJECT_PATH = "/org/mpris/MediaPlayer2"
    PLAYER_IFACE = "org.mpris.MediaPlayer2.Player"
    ROOT_IFACE = "org.mpris.MediaPlayer2"

    def __init__(self, player: RadioPlayer) -> None:
        self._player = player
        self._connection: Optional[Gio.DBusConnection] = None
        self._registration_ids: list[int] = []

        self._bus_name_id = Gio.bus_own_name(
            Gio.BusType.SESSION,
            self.BUS_NAME,
            Gio.BusNameOwnerFlags.NONE,
            self._on_bus_acquired,
            None,
            None,
        )

        self._player.connect(
            "state-changed", lambda *_a: self._notify_player_props(["PlaybackStatus"])
        )
        self._player.connect(
            "station-changed", lambda *_a: self._notify_player_props(["Metadata"])
        )
        self._player.connect(
            "track-changed", lambda *_a: self._notify_player_props(["Metadata"])
        )

    # -- oppsett ------------------------------------------------------------

    def _on_bus_acquired(self, connection: Gio.DBusConnection, _name: str) -> None:
        self._connection = connection
        node_info = Gio.DBusNodeInfo.new_for_xml(_MPRIS_INTROSPECTION_XML)
        for interface in node_info.interfaces:
            reg_id = connection.register_object(
                self.OBJECT_PATH,
                interface,
                self._handle_method_call,
                self._handle_get_property,
                self._handle_set_property,
            )
            self._registration_ids.append(reg_id)
        logger.info("MPRIS-tjeneste registrert som %s", self.BUS_NAME)

    def shutdown(self) -> None:
        if self._connection is not None:
            for reg_id in self._registration_ids:
                self._connection.unregister_object(reg_id)
            self._registration_ids.clear()
        if self._bus_name_id:
            Gio.bus_unown_name(self._bus_name_id)

    # -- metodekall -----------------------------------------------------

    def _handle_method_call(
        self, _connection, _sender, _object_path, interface_name,
        method_name, _parameters, invocation,
    ) -> None:
        if interface_name == self.PLAYER_IFACE:
            if method_name == "Play":
                if self._player.state == PlaybackState.PAUSED:
                    self._player.toggle_pause()
                elif self._player.current_station is not None:
                    self._player.play(self._player.current_station)
            elif method_name == "Pause":
                if self._player.state == PlaybackState.PLAYING:
                    self._player.toggle_pause()
            elif method_name == "PlayPause":
                self._player.toggle_pause()
            elif method_name == "Stop":
                self._player.stop()
            elif method_name in ("Next", "Previous"):
                pass  # Ikke støttet ennå – ingen spillelistenavigasjon
        # org.mpris.MediaPlayer2: Raise/Quit gir ingen effekt i denne appen
        invocation.return_value(None)

    # -- egenskaper -----------------------------------------------------

    def _handle_get_property(
        self, _connection, _sender, _object_path, interface_name, property_name
    ):
        if interface_name == self.ROOT_IFACE:
            root_values = {
                "CanQuit": GLib.Variant("b", False),
                "CanRaise": GLib.Variant("b", False),
                "HasTrackList": GLib.Variant("b", False),
                "Identity": GLib.Variant("s", "GNOME Radio"),
                "DesktopEntry": GLib.Variant("s", APP_ID),
                "SupportedUriSchemes": GLib.Variant("as", ["http", "https"]),
                "SupportedMimeTypes": GLib.Variant("as", []),
            }
            return root_values.get(property_name)

        if interface_name == self.PLAYER_IFACE:
            if property_name == "PlaybackStatus":
                status = {
                    PlaybackState.PLAYING: "Playing",
                    PlaybackState.PAUSED: "Paused",
                }.get(self._player.state, "Stopped")
                return GLib.Variant("s", status)
            if property_name == "Metadata":
                return GLib.Variant("a{sv}", self._build_metadata())
            if property_name == "Volume":
                return GLib.Variant("d", self._player.volume)
            if property_name == "CanGoNext":
                return GLib.Variant("b", False)
            if property_name == "CanGoPrevious":
                return GLib.Variant("b", False)
            if property_name == "CanPlay":
                return GLib.Variant("b", True)
            if property_name == "CanPause":
                return GLib.Variant("b", True)
            if property_name == "CanControl":
                return GLib.Variant("b", True)
        return None

    def _handle_set_property(
        self, _connection, _sender, _object_path, interface_name, property_name, value
    ) -> bool:
        if interface_name == self.PLAYER_IFACE and property_name == "Volume":
            self._player.volume = value.unpack()
            return True
        return False

    def _build_metadata(self) -> dict:
        station = self._player.current_station
        if station is None:
            return {}
        track_id = self.OBJECT_PATH + "/current_track"
        return {
            "mpris:trackid": GLib.Variant("o", track_id),
            "xesam:title": GLib.Variant("s", station.name),
            "xesam:artist": GLib.Variant("as", [station.genre]),
            "xesam:album": GLib.Variant("s", station.country),
        }

    def _notify_player_props(self, prop_names: list[str]) -> None:
        if self._connection is None:
            return
        changed = {}
        for name in prop_names:
            value = self._handle_get_property(
                None, None, None, self.PLAYER_IFACE, name
            )
            if value is not None:
                changed[name] = value
        if not changed:
            return
        self._connection.emit_signal(
            None,
            self.OBJECT_PATH,
            "org.freedesktop.DBus.Properties",
            "PropertiesChanged",
            GLib.Variant("(sa{sv}as)", (self.PLAYER_IFACE, changed, [])),
        )


