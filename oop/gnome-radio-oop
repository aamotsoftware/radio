DEFAULT_COORDINATES = (59.9139, 10.7522)  # Oslo – fallback for ukjente land


def coordinates_for_country(country: str) -> tuple[float, float]:
    """Slår opp en posisjon for landmarkøren, basert på stasjonens land."""
    return COUNTRY_COORDINATES.get(country.strip().lower(), DEFAULT_COORDINATES)


_KM_PER_DEGREE_LATITUDE = 111.32
MARKER_JITTER_RADIUS_KM = 10.0


def jittered_coordinates_for_station(station: "Station") -> tuple[float, float]:
    """Regner ut en markørposisjon for stasjonen, spredt innenfor en
    `MARKER_JITTER_RADIUS_KM`-radius rundt landets senterpunkt.

    Uten dette havner alle stasjoner fra samme land nøyaktig på samme
    koordinat (hovedstaden), og markørene overlapper hverandre på kartet.
    Forskyvningen er deterministisk basert på strøm-URLen, slik at samme
    stasjon alltid havner på samme sted – selv om kartet tegnes på nytt.
    """
    base_lat, base_lon = coordinates_for_country(station.country)

    seed = zlib.crc32(station.url.encode("utf-8"))
    rng = random.Random(seed)
    angle = rng.uniform(0.0, 2 * math.pi)
    # sqrt(uniform) gir jevnt fordelte punkter over hele sirkelens *areal*,
    # i stedet for å klumpe seg opp mot sentrum.
    radius_km = MARKER_JITTER_RADIUS_KM * math.sqrt(rng.uniform(0.0, 1.0))

    delta_lat = (radius_km / _KM_PER_DEGREE_LATITUDE) * math.sin(angle)
    km_per_degree_longitude = _KM_PER_DEGREE_LATITUDE * math.cos(math.radians(base_lat)) or 1.0
    delta_lon = (radius_km / km_per_degree_longitude) * math.cos(angle)

    return base_lat + delta_lat, base_lon + delta_lon


# ---------------------------------------------------------------------------
# Tango-paletten – brukt til å fargekode kartmarkørene
# ---------------------------------------------------------------------------
# Standard GNOME/Tango-farger (middels tone). Hver stasjon får en farge
# deterministisk basert på strøm-URLen, slik at samme stasjon alltid
# får samme farge, og at flere stasjoner enkelt kan skilles fra
# hverandre på kartet selv når de deler land/koordinat.

TANGO_PALETTE: list[tuple[str, str]] = [
    ("butter", "#edd400"),
    ("orange", "#f57900"),
    ("chocolate", "#c17d11"),
    ("chameleon", "#73d216"),
    ("sky-blue", "#3465a4"),
    ("plum", "#75507b"),
    ("scarlet-red", "#cc0000"),
    ("aluminium", "#888a85"),
]


def tango_color_for(key: str) -> tuple[str, str]:
    """Returnerer (css-klassenavn, hex-farge) deterministisk for `key`,
    slik at samme stasjon alltid får samme farge på tvers av kartredraw."""
    index = zlib.crc32(key.encode("utf-8")) % len(TANGO_PALETTE)
    return TANGO_PALETTE[index]


_MARKER_CSS_LOADED = False


def _ensure_marker_css_loaded() -> None:
    """Laster CSS for kartmarkørene én gang per prosess."""
    global _MARKER_CSS_LOADED
    if _MARKER_CSS_LOADED:
        return

    rules = ["""
        .station-marker-pin {
            border-radius: 10px;
            padding: 3px 8px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
        }
        .station-marker-pin .marker-station-name {
            font-weight: bold;
            font-size: 11px;
            color: #ffffff;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
        }
        .station-marker-pin .marker-meta-info {
            font-size: 9px;
            color: #ffffff;
            opacity: 0.9;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
        }
    """]
    for css_class, hex_color in TANGO_PALETTE:
        rules.append(f".tango-{css_class} {{ background-color: {hex_color}; }}")

    provider = Gtk.CssProvider()
    provider.load_from_data("\n".join(rules).encode("utf-8"))
    Gtk.StyleContext.add_provider_for_display(
        Gdk.Display.get_default(),
        provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
    )
    _MARKER_CSS_LOADED = True


class PlaybackState(Enum):
    STOPPED = auto()
    BUFFERING = auto()
    PLAYING = auto()
    PAUSED = auto()
    ERROR = auto()


