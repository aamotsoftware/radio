class StationMarker(Shumate.Marker):
    """Én landmarkør på kartet – representerer én radiostasjon.

    Markøren er en liten fargelagt «pin» bygget som et Shumate.Marker-barn,
    med to tekstlinjer:
        - metainfo (stasjonens sjanger)
        - stasjonsnavnet

    Fargen hentes deterministisk fra Tango-paletten basert på strøm-URLen,
    så samme stasjon alltid får samme farge, og ulike stasjoner er lette
    å skille fra hverandre på kartet. Favoritter får i tillegg et lite
    stjerneikon foran metainfo-linjen.

    Posisjonen er spredt innenfor `MARKER_JITTER_RADIUS_KM` rundt landets
    senterpunkt (se `jittered_coordinates_for_station`), slik at flere
    stasjoner fra samme land ikke havner oppå hverandre.

    Et klikk på markøren starter avspilling av stasjonen, via
    `on_activate`-callbacken som gis inn fra MapView/RadioWindow.
    """

    __gtype_name__ = "StationMarker"

    def __init__(
        self,
        station: Station,
        on_activate: Optional[Callable[[Station], None]] = None,
    ) -> None:
        super().__init__()
        self.station = station
        _ensure_marker_css_loaded()

        lat, lon = jittered_coordinates_for_station(station)
        self.set_location(lat, lon)

        css_class, _hex_color = tango_color_for(station.url)

        pin = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        pin.add_css_class("station-marker-pin")
        pin.add_css_class(f"tango-{css_class}")

        meta_text = station.genre or "Ukjent"
        if station.favorite:
            meta_text = f"★ {meta_text}"
        meta_label = Gtk.Label(label=meta_text, xalign=0)
        meta_label.add_css_class("marker-meta-info")

        name_label = Gtk.Label(label=station.name, xalign=0)
        name_label.add_css_class("marker-station-name")
        name_label.set_ellipsize(3)  # Pango.EllipsizeMode.END
        name_label.set_max_width_chars(18)

        pin.append(meta_label)
        pin.append(name_label)
        pin.set_tooltip_text(f"{station.name} – {station.genre} · {station.country}")

        if on_activate is not None:
            pin.add_css_class("activatable")
            click_gesture = Gtk.GestureClick()
            click_gesture.connect(
                "released", lambda *_a: on_activate(station)
            )
            pin.add_controller(click_gesture)
            pin.set_cursor(Gdk.Cursor.new_from_name("pointer"))

        self.set_child(pin)


class MapView(Gtk.Widget):
    """Viser et OpenStreetMap-kart med en landmarkør for hver stasjon som
    finnes i biblioteket. Rent visningsobjekt: kjenner ikke til
    StationLibrary, bare til stasjonslisten den blir bedt om å tegne opp
    via `set_stations()`.
    """

    __gtype_name__ = "MapView"

    def __init__(self, on_station_activate: Optional[Callable[[Station], None]] = None) -> None:
        super().__init__()
        self.set_layout_manager(Gtk.BinLayout())
        self._on_station_activate = on_station_activate

        registry = Shumate.MapSourceRegistry.new_with_defaults()
        osm_source = registry.get_by_id(Shumate.MAP_SOURCE_OSM_MAPNIK)

        self._simple_map = Shumate.SimpleMap()
        self._simple_map.set_map_source(osm_source)
        self._simple_map.set_parent(self)

        self._marker_layer = Shumate.MarkerLayer.new(self._simple_map.get_viewport())
        self._simple_map.get_map().insert_layer_behind(self._marker_layer, None)

        # Startvisning: sentrert over Norden, moderat zoom
        viewport = self._simple_map.get_viewport()
        viewport.set_zoom_level(4)
        self._simple_map.get_map().center_on(*DEFAULT_COORDINATES)

    def set_stations(self, stations: list[Station]) -> None:
        """Tegner kartet på nytt med én markør per stasjon i listen."""
        self._marker_layer.remove_all()
        for station in stations:
            self._marker_layer.add_marker(
                StationMarker(station, on_activate=self._on_station_activate)
            )

    def focus_station(self, station: Station, zoom_level: float = 10.0) -> None:
        """Panorer/zoom kartet til stasjonens faktiske markørposisjon."""
        lat, lon = jittered_coordinates_for_station(station)
        self._simple_map.get_map().go_to_full(lat, lon, zoom_level)


