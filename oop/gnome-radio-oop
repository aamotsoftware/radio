class StationEditDialog(Adw.Window):
    """Modal dialog for å legge til eller redigere en stasjon.

    Rent visningsobjekt: kjenner ikke til StationLibrary, bare til
    en `on_save`-callback som mottar den ferdige Station-instansen.
    """

    def __init__(
        self,
        parent: Gtk.Window,
        on_save: Callable[[Station], None],
        station: Optional[Station] = None,
    ) -> None:
        is_edit = station is not None
        super().__init__(
            transient_for=parent,
            modal=True,
            default_width=380,
            default_height=-1,
            title="Rediger stasjon" if is_edit else "Legg til stasjon",
        )
        self._on_save = on_save
        self._editing_station = station

        toolbar_view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        toolbar_view.add_top_bar(header)

        save_button = Gtk.Button(label="Lagre")
        save_button.add_css_class("suggested-action")
        save_button.connect("clicked", self._on_save_clicked)
        header.pack_end(save_button)

        cancel_button = Gtk.Button(label="Avbryt")
        cancel_button.connect("clicked", lambda _b: self.close())
        header.pack_start(cancel_button)

        group = Adw.PreferencesGroup(
            margin_top=16, margin_bottom=16, margin_start=16, margin_end=16
        )

        self._name_row = Adw.EntryRow(title="Navn")
        self._url_row = Adw.EntryRow(title="Strøm-URL")
        self._genre_row = Adw.EntryRow(title="Sjanger")
        self._country_row = Adw.EntryRow(title="Land")

        if station is not None:
            self._name_row.set_text(station.name)
            self._url_row.set_text(station.url)
            self._genre_row.set_text(station.genre)
            self._country_row.set_text(station.country)
        else:
            self._country_row.set_text("Norge")

        for row in (self._name_row, self._url_row, self._genre_row, self._country_row):
            group.add(row)

        toolbar_view.set_content(group)
        self.set_content(toolbar_view)

    def _on_save_clicked(self, _button: Gtk.Button) -> None:
        name = self._name_row.get_text().strip()
        url = self._url_row.get_text().strip()
        if not name or not url:
            self._name_row.add_css_class("error" if not name else "")
            self._url_row.add_css_class("error" if not url else "")
            return

        station = Station(
            name=name,
            url=url,
            genre=self._genre_row.get_text().strip() or "Ukjent",
            country=self._country_row.get_text().strip() or "Norge",
            favorite=self._editing_station.favorite if self._editing_station else False,
        )
        self._on_save(station)
        self.close()


class RadioWindow(Adw.ApplicationWindow):
    """Hovedvinduet. Observerer RadioPlayer og delegerer handlinger til det."""

    def __init__(self, app: "RadioApplication") -> None:
        super().__init__(application=app, title="GNOME Radio")
        self.set_default_size(420, 640)

        self._library = app.library
        self._player = app.player
        self._player.connect("state-changed", self._on_state_changed)
        self._player.connect("station-changed", self._on_station_changed)
        self._player.connect("track-changed", self._on_track_changed)
        self._player.connect("error", self._on_player_error)

        self._showing_favorites_only = False
        self._current_search = ""

        self._build_ui()
        self._populate_station_list(self._library.all())

    # -- oppbygging av UI ---------------------------------------------------

    def _build_ui(self) -> None:
        toolbar_view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        toolbar_view.add_top_bar(header)

        search_entry = Gtk.SearchEntry(placeholder_text="Søk etter stasjon, sjanger …")
        search_entry.connect("search-changed", self._on_search_changed)
        header.set_title_widget(search_entry)

        self._favorites_toggle = Gtk.ToggleButton(icon_name="starred-symbolic")
        self._favorites_toggle.set_tooltip_text("Vis kun favoritter")
        self._favorites_toggle.connect("toggled", self._on_favorites_filter_toggled)
        header.pack_start(self._favorites_toggle)

        self._map_toggle = Gtk.ToggleButton(icon_name="mark-location-symbolic")
        self._map_toggle.set_tooltip_text("Vis kart over stasjoner")
        self._map_toggle.connect("toggled", self._on_map_view_toggled)
        header.pack_start(self._map_toggle)

        add_button = Gtk.Button(icon_name="list-add-symbolic")
        add_button.set_tooltip_text("Legg til stasjon")
        add_button.connect("clicked", self._on_add_station_clicked)
        header.pack_end(add_button)

        primary_menu = Gio.Menu()
        primary_menu.append("Importer stasjoner …", "win.import-stations")
        primary_menu.append("Eksporter stasjoner …", "win.export-stations")
        primary_menu_button = Gtk.MenuButton(icon_name="open-menu-symbolic")
        primary_menu_button.set_menu_model(primary_menu)
        primary_menu_button.set_tooltip_text("Meny")
        header.pack_end(primary_menu_button)

        import_action = Gio.SimpleAction.new("import-stations", None)
        import_action.connect("activate", self._on_import_stations)
        self.add_action(import_action)

        export_action = Gio.SimpleAction.new("export-stations", None)
        export_action.connect("activate", self._on_export_stations)
        self.add_action(export_action)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        self._station_list = Gtk.ListBox()
        self._station_list.add_css_class("boxed-list")
        self._station_list.set_selection_mode(Gtk.SelectionMode.NONE)
        self._station_list.connect("row-activated", self._on_row_activated)

        scroller = Gtk.ScrolledWindow(vexpand=True)
        scroller.set_child(self._station_list)
        scroller.set_margin_top(8)
        scroller.set_margin_start(8)
        scroller.set_margin_end(8)

        self._map_view = MapView(on_station_activate=self._on_map_marker_activated)
        self._map_view.set_vexpand(True)

        self._content_stack = Gtk.Stack(vexpand=True)
        self._content_stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self._content_stack.add_named(scroller, "list")
        self._content_stack.add_named(self._map_view, "map")
        root.append(self._content_stack)

        root.append(self._build_playback_bar())
        toolbar_view.set_content(root)

        self._toast_overlay = Adw.ToastOverlay()
        self._toast_overlay.set_child(toolbar_view)
        self.set_content(self._toast_overlay)

    def _build_playback_bar(self) -> Gtk.Widget:
        bar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                      margin_top=8, margin_bottom=12, margin_start=16, margin_end=16)

        self._now_playing_label = Gtk.Label(label="Ingen stasjon valgt", xalign=0)
        self._now_playing_label.add_css_class("title-3")

        self._track_label = Gtk.Label(label="", xalign=0, visible=False)
        self._track_label.add_css_class("dim-label")
        self._track_label.set_ellipsize(3)  # Pango.EllipsizeMode.END

        self._status_label = Gtk.Label(label="Stoppet", xalign=0)
        self._status_label.add_css_class("dim-label")

        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self._play_pause_button = Gtk.Button(icon_name="media-playback-start-symbolic")
        self._play_pause_button.connect("clicked", lambda _b: self._player.toggle_pause())

        stop_button = Gtk.Button(icon_name="media-playback-stop-symbolic")
        stop_button.connect("clicked", lambda _b: self._player.stop())

        self._mute_button = Gtk.ToggleButton(icon_name="audio-volume-high-symbolic")
        self._mute_button.connect("toggled", self._on_mute_toggled)

        volume_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 0.05)
        volume_scale.set_value(self._player.volume)
        volume_scale.set_hexpand(True)
        volume_scale.connect("value-changed",
                              lambda s: setattr(self._player, "volume", s.get_value()))
        self._volume_scale = volume_scale

        controls.append(self._play_pause_button)
        controls.append(stop_button)
        controls.append(self._mute_button)
        controls.append(volume_scale)

        bar.append(self._now_playing_label)
        bar.append(self._track_label)
        bar.append(self._status_label)
        bar.append(controls)
        return bar

    # -- stasjonslisten -----------------------------------------------------

    def _populate_station_list(self, stations: list[Station]) -> None:
        child = self._station_list.get_first_child()
        while child is not None:
            next_child = child.get_next_sibling()
            self._station_list.remove(child)
            child = next_child

        for station in stations:
            row = StationRow(
                station,
                on_favorite_toggle=self._on_favorite_toggle,
                on_edit=self._on_edit_station,
                on_delete=self._on_delete_station,
            )
            self._station_list.append(row)

        # Kartet følger samme liste (søk/favorittfilter) som listevisningen,
        # slik at nye stasjoner får en landmarkør så snart de legges til.
        self._map_view.set_stations(stations)

    def _refresh_station_list(self) -> None:
        """Slår sammen gjeldende søk og favoritt-filter og tegner listen på nytt."""
        stations = self._library.search(self._current_search)
        if self._showing_favorites_only:
            stations = [s for s in stations if s.favorite]
        self._populate_station_list(stations)

    def _on_search_changed(self, entry: Gtk.SearchEntry) -> None:
        self._current_search = entry.get_text()
        self._refresh_station_list()

    def _on_favorites_filter_toggled(self, button: Gtk.ToggleButton) -> None:
        self._showing_favorites_only = button.get_active()
        self._refresh_station_list()

    def _on_map_view_toggled(self, button: Gtk.ToggleButton) -> None:
        self._content_stack.set_visible_child_name("map" if button.get_active() else "list")

    def _on_row_activated(self, _listbox, row: StationRow) -> None:
        self._player.play(row.station)

    def _on_map_marker_activated(self, station: Station) -> None:
        """Starter avspilling når en stasjon klikkes på kartet."""
        self._player.play(station)

    def _on_favorite_toggle(self, station: Station) -> None:
        self._library.toggle_favorite(station)
        # Alltid oppdater (ikke bare når favorittfilteret er på): kartmarkøren
        # skal bytte ikon til stjerne så snart en stasjon merkes som favoritt.
        self._refresh_station_list()

    def _on_add_station_clicked(self, _button: Gtk.Button) -> None:
        dialog = StationEditDialog(self, on_save=self._on_station_saved)
        dialog.present()

    def _on_edit_station(self, station: Station) -> None:
        dialog = StationEditDialog(self, on_save=self._on_station_saved, station=station)
        dialog.present()

    def _on_station_saved(self, station: Station) -> None:
        existing_urls = {s.url for s in self._library.all()}
        is_new_url = station.url not in existing_urls
        # Enkel heuristikk: hvis dialogen ble åpnet for redigering av en
        # stasjon som fortsatt finnes med samme URL, bruk update(); ellers add().
        matching = next((s for s in self._library.all() if s.url == station.url), None)
        if matching is not None:
            self._library.update(matching, station)
            self._toast_overlay.add_toast(Adw.Toast(title=f"Oppdaterte «{station.name}»"))
        else:
            self._library.add(station)
            self._toast_overlay.add_toast(Adw.Toast(title=f"La til «{station.name}»"))
        self._refresh_station_list()

    def _on_delete_station(self, station: Station) -> None:
        self._library.remove(station)
        if self._player.current_station is station:
            self._player.stop()
        self._refresh_station_list()
        self._toast_overlay.add_toast(Adw.Toast(title=f"Slettet «{station.name}»"))

    # -- import/eksport -------------------------------------------------

    def _on_export_stations(self, _action=None, _param=None) -> None:
        dialog = Gtk.FileDialog(initial_name="radiostasjoner.json")
        dialog.save(self, None, self._on_export_dialog_done)

    def _on_export_dialog_done(self, dialog: Gtk.FileDialog, result: Gio.AsyncResult) -> None:
        try:
            gfile = dialog.save_finish(result)
        except GLib.Error as exc:
            logger.info("Eksport avbrutt eller feilet: %s", exc)
            return
        path = Path(gfile.get_path())
        try:
            count = self._library.export_to_path(path)
        except OSError as exc:
            self._toast_overlay.add_toast(Adw.Toast(title=f"Kunne ikke eksportere: {exc}"))
            return
        self._toast_overlay.add_toast(
            Adw.Toast(title=f"Eksporterte {count} stasjoner til {path.name}")
        )

    def _on_import_stations(self, _action=None, _param=None) -> None:
        json_filter = Gtk.FileFilter()
        json_filter.set_name("JSON-filer")
        json_filter.add_pattern("*.json")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(json_filter)

        dialog = Gtk.FileDialog(default_filter=json_filter)
        dialog.set_filters(filters)
        dialog.open(self, None, self._on_import_dialog_done)

    def _on_import_dialog_done(self, dialog: Gtk.FileDialog, result: Gio.AsyncResult) -> None:
        try:
            gfile = dialog.open_finish(result)
        except GLib.Error as exc:
            logger.info("Import avbrutt eller feilet: %s", exc)
            return
        path = Path(gfile.get_path())
        try:
            count = self._library.import_from_path(path, replace=False)
        except (json.JSONDecodeError, ValueError, KeyError, OSError) as exc:
            self._toast_overlay.add_toast(Adw.Toast(title=f"Kunne ikke importere: {exc}"))
            return
        self._refresh_station_list()
        self._toast_overlay.add_toast(Adw.Toast(title=f"Importerte {count} stasjoner"))

    def _on_mute_toggled(self, button: Gtk.ToggleButton) -> None:
        self._player.toggle_mute()
        muted = self._player.is_muted
        button.set_icon_name(
            "audio-volume-muted-symbolic" if muted else "audio-volume-high-symbolic"
        )
        self._volume_scale.set_sensitive(not muted)

    # -- reaksjoner på RadioPlayer-signaler ---------------------------------

    def _on_state_changed(self, _player, state: PlaybackState) -> None:
        labels = {
            PlaybackState.STOPPED: "Stoppet",
            PlaybackState.BUFFERING: "Bufrer …",
            PlaybackState.PLAYING: "Spiller av",
            PlaybackState.PAUSED: "Pause",
            PlaybackState.ERROR: "Feil ved avspilling",
        }
        self._status_label.set_label(labels.get(state, ""))
        icon = "media-playback-pause-symbolic" if state == PlaybackState.PLAYING \
            else "media-playback-start-symbolic"
        self._play_pause_button.set_icon_name(icon)

    def _on_station_changed(self, _player, station: Station) -> None:
        self._now_playing_label.set_label(station.name)
        self._track_label.set_visible(False)
        self._track_label.set_label("")

    def _on_track_changed(self, _player, title: str) -> None:
        if title:
            self._track_label.set_label(title)
            self._track_label.set_visible(True)
        else:
            self._track_label.set_visible(False)
            self._track_label.set_label("")

    def _on_player_error(self, _player, message: str) -> None:
        logger.error("Avspillingsfeil: %s", message)
        self._toast_overlay.add_toast(
            Adw.Toast(title=f"Kunne ikke spille av: {message}", timeout=5)
        )


# ---------------------------------------------------------------------------
# Applikasjon
# ---------------------------------------------------------------------------

class RadioApplication(Adw.Application):
    """Gtk.Application-underklasse. Eier de langlevde objektene."""

    def __init__(self) -> None:
        super().__init__(application_id=APP_ID,
                          flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.library = StationLibrary()
        self.player = RadioPlayer()
        self.mpris = MPRISService(self.player)
        self._window: Optional[RadioWindow] = None

    def do_activate(self) -> None:  # noqa: N802 (GTK-navnekonvensjon)
        if self._window is None:
            self._window = RadioWindow(self)
        self._window.present()

    def do_shutdown(self) -> None:  # noqa: N802 (GTK-navnekonvensjon)
        self.mpris.shutdown()
        Adw.Application.do_shutdown(self)


def main() -> int:
    app = RadioApplication()
    return app.run(None)


if __name__ == "__main__":
    raise SystemExit(main())
