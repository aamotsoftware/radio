# Landkoordinater for kartvisning
# ---------------------------------------------------------------------------
# Stasjonens `country`-felt er fritekst på norsk (f.eks. «Norge», «Sverige»),
# så oppslaget er nøkkelbasert på norske stedsnavn – ikke ISO-landkoder.
# Verdiene er hovedstad/sentroide, brukt som posisjon for landmarkøren.
# Utvid gjerne tabellen selv, eller koble på Nominatim (OSM sin geokodings-
# tjeneste) dersom du vil ha presise per-stasjon-koordinater i stedet.

COUNTRY_COORDINATES: dict[str, tuple[float, float]] = {
    "norge": (59.9139, 10.7522),
    "sverige": (59.3293, 18.0686),
    "danmark": (55.6761, 12.5683),
    "finland": (60.1699, 24.9384),
    "island": (64.1466, -21.9426),
    "tyskland": (52.5200, 13.4050),
    "frankrike": (48.8566, 2.3522),
    "storbritannia": (51.5074, -0.1278),
    "nederland": (52.3676, 4.9041),
    "spania": (40.4168, -3.7038),
    "italia": (41.9028, 12.4964),
    "polen": (52.2297, 21.0122),
    "usa": (38.9072, -77.0369),
    "japan": (35.6762, 139.6503),
    "brasil": (-15.7939, -47.8828),
    "australia": (-35.2809, 149.1300),
    "canada": (45.4215, -75.6972),
